                        <label for="ROJA45_QUOTATIONSPRO_ENABLE_MULTIPLEFILEUPLOAD_on">{l s='Yes' mod='roja45quotationspro'}</label>
                        <input type="radio" name="ROJA45_QUOTATIONSPRO_ENABLE_MULTIPLEFILEUPLOAD" id="ROJA45_QUOTATIONSPRO_ENABLE_MULTIPLEFILEUPLOAD_off" value="0" {if ($fields_value['ROJA45_QUOTATIONSPRO_ENABLE_MULTIPLEFILEUPLOAD'] == "0")}checked="checked"{/if}>

                    </label>
                    <div class="col-lg-7">
                        <input type="text" name="ROJA45_QUOTATIONSPRO_REFERENCE_FORMAT" id="ROJA45_QUOTATIONSPRO_REFERENCE_FORMAT" value="{$fields_value['ROJA45_QUOTATIONSPRO_REFERENCE_FORMAT']|escape:'html':'UTF-8'}" class="">
                        <div class="row-margin-top alert alert-info" style="">
                            <p>{l s='The reference has a maximum length of 32 characters' mod='roja45quotationspro'}</p>
                            <p>{l s='The following tokens are available' mod='roja45quotationspro'}</p>
                            <p>[sequential n] {l s='The module will find the last quotation reference number used, and increment the value.  The string will be padded to the value of n.' mod='roja45quotationspro'}</p>
                            <p>[random n] {l s='The module will generate a random string to the length of n.' mod='roja45quotationspro'}</p>
                            <p>[day] {l s='The module will insert the two digit day date.' mod='roja45quotationspro'}</p>
                            <p>[month] {l s='The module will insert the two digit month.' mod='roja45quotationspro'}</p>

                    <label class="control-label col-lg-3">
                        <span class="label-tooltip" data-toggle="tooltip" data-html="true" title="" data-original-title="{l s='Allow employees to reassign quotations (Can release only if no).' mod='roja45quotationspro'}">{l s='Employees can reassign quotations' mod='roja45quotationspro'}</span>

                                <label for="ROJA45_QUOTATIONSPRO_ENABLE_EMPLOYEE_REASSIGN_on">{l s='Yes' mod='roja45quotationspro'}</label>
                                <input type="radio" name="ROJA45_QUOTATIONSPRO_ENABLE_EMPLOYEE_REASSIGN" id="ROJA45_QUOTATIONSPRO_ENABLE_EMPLOYEE_REASSIGN_off" value="0" {if ($fields_value['ROJA45_QUOTATIONSPRO_ENABLE_EMPLOYEE_REASSIGN'] == "0")}checked="checked"{/if}>
                                <label for="ROJA45_QUOTATIONSPRO_ENABLE_EMPLOYEE_REASSIGN_off">{l s='No' mod='roja45quotationspro'}</label>
                                <a class="slide-button btn"></a>

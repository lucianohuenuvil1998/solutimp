                        <input type="radio" name="ROJA45_QUOTATIONSPRO_ENABLE_CAPTCHA" id="ROJA45_QUOTATIONSPRO_ENABLE_CAPTCHA_on" value="1" {if ($fields_value['ROJA45_QUOTATIONSPRO_ENABLE_CAPTCHA'] == "1")}checked="checked"{/if}>
                        <label for="ROJA45_QUOTATIONSPRO_ENABLE_CAPTCHA_on">{l s='Yes' mod='roja45quotationspro'}</label>
                        <input type="radio" name="ROJA45_QUOTATIONSPRO_ENABLE_CAPTCHA" id="ROJA45_QUOTATIONSPRO_ENABLE_CAPTCHA_off" value="0" {if ($fields_value['ROJA45_QUOTATIONSPRO_ENABLE_CAPTCHA'] == "0")}checked="checked"{/if}>
                        <label for="ROJA45_QUOTATIONSPRO_ENABLE_CAPTCHA_off">{l s='No' mod='roja45quotationspro'}</label>

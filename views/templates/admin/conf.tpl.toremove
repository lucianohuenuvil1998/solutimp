                </label>
                <div class="col-lg-7">
                    <p>{l s='To use Google reCaptcha you should first register your site here: ' mod='roja45quotationspro'}<a href="https://www.google.com/recaptcha/" target="_blank">{l s='Google Recaptcha' mod='roja45quotationspro'}</a></p>
                </div>

                    <span class="label-tooltip" data-toggle="tooltip" data-html="true" title="" data-original-title="{l s='Select the Customer Quotation PDF template' mod='roja45quotationspro'}">{l s='Customer Quotation PDF Template' mod='roja45quotationspro'}</span>

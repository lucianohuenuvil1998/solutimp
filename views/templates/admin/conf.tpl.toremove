                                <input type="radio" name="ROJA45_QUOTATIONSPRO_ENABLE_EMPLOYEE_HIDE" id="ROJA45_QUOTATIONSPRO_ENABLE_EMPLOYEE_HIDE_off" value="0" {if ($fields_value['ROJA45_QUOTATIONSPRO_ENABLE_EMPLOYEE_HIDE'] == "0")}checked="checked"{/if}>
                                <label for="ROJA45_QUOTATIONSPRO_ENABLE_EMPLOYEE_HIDE_off">{l s='No' mod='roja45quotationspro'}</label>

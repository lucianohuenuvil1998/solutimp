            <div class="form-group">
                <label class="control-label col-lg-3">
                    <span class="label-tooltip" data-toggle="tooltip" data-html="true" title="" data-original-title="{l s='When enabled, clicking the quote cart will display a dropdown summary of the contents.' mod='roja45quotationspro'}">{l s='Enable Quote Cart Dropdown' mod='roja45quotationspro'}</span>

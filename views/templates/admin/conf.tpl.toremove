                        <label for="ROJA45_QUOTATIONSPRO_ENABLE_FILEUPLOAD_on">{l s='Yes' mod='roja45quotationspro'}</label>
                        <input type="radio" name="ROJA45_QUOTATIONSPRO_ENABLE_FILEUPLOAD" id="ROJA45_QUOTATIONSPRO_ENABLE_FILEUPLOAD_off" value="0" {if ($fields_value['ROJA45_QUOTATIONSPRO_ENABLE_FILEUPLOAD'] == "0")}checked="checked"{/if}>
